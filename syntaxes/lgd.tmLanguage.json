{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"fileTypes": [
		"lgd"
	],
	"name": "LGD",
	"patterns": [
		{
			"include": "#class-declaration"
		},
		{
			"include": "#method-modifier"
		},
		{
			"include": "#typed-method"
		},
		{
			"include": "#typed-declaration"
		},
		{
			"include": "#typed-keyword"
		},
		{
			"include": "source.js"
		}
	],
	"injections": {
		"L:source.lgd -comment -string": {
			"comment": "Apply LGD declaration rules inside nested JavaScript blocks, excluding comments and strings.",
			"patterns": [
				{
					"include": "#class-declaration"
				},
				{
					"include": "#method-modifier"
				},
				{
					"include": "#typed-method"
				},
				{
					"include": "#typed-declaration"
				},
				{
					"include": "#typed-keyword"
				}
			]
		},
		"L:source.lgd meta.parameters.js -comment -string": {
			"patterns": [
				{
					"include": "#typed-parameter"
				}
			]
		},
		"L:source.lgd meta.class.lgd meta.return.type.js -meta.type.paren.cover -comment -string": {
			"patterns": [
				{
					"include": "#base-initializer-keyword"
				}
			]
		},
		"L:source.lgd meta.class.lgd meta.block.js -meta.function-call -comment -string": {
			"patterns": [
				{
					"include": "#base-method-keyword"
				}
			]
		}
	},
	"repository": {
		"typed-declaration": {
			"comment": "A full typed declaration head: [export] [readonly] Type name.",
			"match": "^([ \\t]*)((export)[ \\t]+)?((readonly)[ \\t]+)?((?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*\\??)([ \\t]+)([$_a-zA-Z][\\w$]*)(?![\\w$]|[ \\t]*\\()",
			"captures": {
				"3": {
					"name": "keyword.control.lgd"
				},
				"5": {
					"name": "storage.modifier.lgd"
				},
				"6": {
					"name": "storage.type.lgd"
				},
				"8": {
					"name": "variable.other.definition.lgd"
				}
			}
		},
		"typed-keyword": {
			"captures": {
				"1": {
					"name": "storage.type.lgd"
				}
			},
			"comment": "A line starting with a type keyword that is not a full declaration: malformed, or a call like Number(\"5\").",
			"match": "^[ \\t]*(?:export[ \\t]+)?(?:readonly[ \\t]+)?(Number|String|Boolean|BigInt|Symbol|Object|Array|Function)\\b(?![ \\t]*\\()"
		},
		"class-declaration": {
			"name": "meta.class.lgd",
			"comment": "Declaration/modifier scopes also cover contextual public/sealed headers without enabling unsupported compiler syntax.",
			"begin": "^([ \\t]*)(?:(export)[ \\t]+)?((?:(?:abstract|sealed|public|protected|private|static)[ \\t]+)*)(class|interface|enum)[ \\t]+([$_a-zA-Z][\\w$]*)(?:[ \\t]*(:)[ \\t]*([$_a-zA-Z][\\w$]*(?:\\.[_a-zA-Z$][\\w$]*)*))?",
			"beginCaptures": {
				"2": {
					"name": "keyword.control.lgd"
				},
				"3": {
					"patterns": [
						{
							"match": "\\b(?:abstract|sealed|public|protected|private|static)\\b",
							"name": "storage.modifier.lgd"
						}
					]
				},
				"4": {
					"name": "storage.type.lgd"
				},
				"5": {
					"name": "entity.name.type.class.lgd"
				},
				"6": {
					"name": "punctuation.separator.inheritance.lgd"
				},
				"7": {
					"name": "entity.name.type.class.lgd"
				}
			},
			"end": "(?<=\\})",
			"patterns": [
				{
					"include": "source.js#comment"
				},
				{
					"include": "source.js#class-or-interface-body"
				}
			]
		},
		"typed-method": {
			"comment": "Color only the return prefix so native JavaScript rules still parse the method name and parameters.",
			"match": "[ \\t]*\\b(?:(async)[ \\t]+)?(?:(void)|((?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*\\??))(?=[ \\t]+[$_a-zA-Z][\\w$]*[ \\t]*\\()",
			"captures": {
				"1": {
					"name": "storage.modifier.lgd"
				},
				"2": {
					"name": "keyword.type.lgd"
				},
				"3": {
					"name": "storage.type.lgd"
				}
			}
		},
		"typed-parameter": {
			"comment": "Parameter type fallback before semantic tokens arrive; leave names to JavaScript parameter scopes.",
			"match": "\\b((?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*\\??)(?=[ \\t]+[$_a-zA-Z][\\w$]*\\b)",
			"captures": {
				"1": {
					"name": "storage.type.lgd"
				}
			}
		},
		"method-modifier": {
			"comment": "Contextual declaration modifiers are theme roles only; compiler support is unchanged.",
			"match": "(?<![\\w$.])\\b(abstract|virtual|override|public|protected|private|sealed|static|async|readonly)\\b(?=[ \\t]+(?:(?:abstract|virtual|override|public|protected|private|sealed|static|async|readonly)[ \\t]+)*(?:\\*[ \\t]*)?(?:(?:void|(?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*\\??)[ \\t]+)?[$_a-zA-Z][\\w$]*[ \\t]*\\()",
			"captures": {
				"1": {
					"name": "storage.modifier.lgd"
				}
			}
		},
		"base-initializer-keyword": {
			"comment": "Constructor initializer fallback while the JavaScript grammar treats the colon as a return annotation.",
			"name": "variable.language.lgd",
			"match": "(?<![\\w$.])\\bbase\\b(?=[ \\t]*\\()"
		},
		"base-method-keyword": {
			"comment": "Direct base method dispatch in class bodies; native call scopes keep ordinary property names unchanged.",
			"name": "variable.language.lgd",
			"match": "(?<![\\w$.])\\bbase\\b(?=[ \\t]*\\.[ \\t]*[$_a-zA-Z][\\w$]*[ \\t]*\\()"
		}
	},
	"scopeName": "source.lgd"
}
