{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"fileTypes": [
		"lgd"
	],
	"name": "LGD",
	"patterns": [
		{
			"include": "#type-cast"
		},
		{
			"include": "#class-declaration"
		},
		{
			"include": "#method-modifier"
		},
		{
			"include": "#accessor-visibility"
		},
		{
			"include": "#typed-method"
		},
		{
			"include": "#typed-field"
		},
		{
			"include": "#typed-declaration"
		},
		{
			"include": "#typed-keyword"
		},
		{
			"include": "source.js"
		}
	],
	"injections": {
		"L:source.lgd -comment -string": {
			"comment": "Apply LGD declaration rules inside nested JavaScript blocks, excluding comments and strings.",
			"patterns": [
				{
					"include": "#type-cast"
				},
				{
					"include": "#class-declaration"
				},
				{
					"include": "#method-modifier"
				},
				{
					"include": "#accessor-visibility"
				},
				{
					"include": "#typed-method"
				},
				{
					"include": "#typed-field"
				},
				{
					"include": "#typed-declaration"
				},
				{
					"include": "#typed-keyword"
				}
			]
		},
		"L:source.lgd meta.parameters.js -comment -string": {
			"patterns": [
				{
					"include": "#typed-parameter"
				}
			]
		},
		"L:source.lgd meta.class.lgd meta.return.type.js -meta.type.paren.cover -comment -string": {
			"patterns": [
				{
					"include": "#base-initializer-keyword"
				}
			]
		},
		"L:source.lgd meta.class.lgd meta.block.js -meta.function-call -comment -string": {
			"patterns": [
				{
					"include": "#base-method-keyword"
				}
			]
		}
	},
	"repository": {
		"typed-declaration": {
			"comment": "A full typed declaration head: [export] [const] Type name; readonly is a legacy local spelling.",
			"match": "^([ \\t]*)((export)[ \\t]+)?((const|let|readonly)[ \\t]+)?((?:(?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*|number|string|boolean|bigint|symbol|object)(?:\\[\\]|\\?)*)([ \\t]+)([$_a-zA-Z][\\w$]*)(?![\\w$]|[ \\t]*\\()",
			"captures": {
				"3": {
					"name": "keyword.control.lgd"
				},
				"5": {
					"patterns": [
						{
							"match": "\\bconst\\b",
							"name": "storage.type.lgd"
						},
						{
							"match": "\\breadonly\\b",
							"name": "storage.modifier.lgd"
						}
					]
				},
				"6": {
					"name": "storage.type.lgd"
				},
				"8": {
					"name": "variable.other.definition.lgd"
				}
			}
		},
		"typed-keyword": {
			"captures": {
				"1": {
					"name": "storage.type.lgd"
				}
			},
			"comment": "A line starting with a type keyword that is not a full declaration: malformed, or a call like Number(\"5\").",
			"match": "^[ \\t]*(?:export[ \\t]+)?(?:(?:const|let|readonly)[ \\t]+)?(Number|String|Boolean|BigInt|Symbol|Object|Array|Function)\\b(?![ \\t]*\\()"
		},
		"class-declaration": {
			"name": "meta.class.lgd",
			"comment": "Class, interface, and enum declaration heads retain their declaration and contextual modifier scopes.",
			"begin": "^([ \\t]*)(?:(export)[ \\t]+)?((?:(?:abstract|sealed|public|protected|private|internal|static)[ \\t]+)*)(class|interface|enum)[ \\t]+([$_a-zA-Z][\\w$]*)(?:[ \\t]*(:)[ \\t]*([$_a-zA-Z][\\w$]*(?:\\.[_a-zA-Z$][\\w$]*)*))?",
			"beginCaptures": {
				"2": {
					"name": "keyword.control.lgd"
				},
				"3": {
					"patterns": [
						{
							"match": "\\b(?:abstract|sealed|public|protected|private|internal|static)\\b",
							"name": "storage.modifier.lgd"
						}
					]
				},
				"4": {
					"name": "storage.type.lgd"
				},
				"5": {
					"name": "entity.name.type.class.lgd"
				},
				"6": {
					"name": "punctuation.separator.inheritance.lgd"
				},
				"7": {
					"name": "entity.name.type.class.lgd"
				}
			},
			"end": "(?<=\\})",
			"patterns": [
				{
					"include": "source.js#comment"
				},
				{
					"include": "source.js#class-or-interface-body"
				}
			]
		},
		"typed-method": {
			"comment": "Color only the return prefix so native JavaScript rules still parse the method name and parameters.",
			"match": "[ \\t]*\\b(?:(async)[ \\t]+)?(?:(void)|((?:(?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*|number|string|boolean|bigint|symbol|object)(?:\\[\\]|\\?)*))(?=[ \\t]+[$_a-zA-Z][\\w$]*[ \\t]*\\()",
			"captures": {
				"1": {
					"name": "storage.modifier.lgd"
				},
				"2": {
					"name": "keyword.type.lgd"
				},
				"3": {
					"name": "storage.type.lgd"
				}
			}
		},
		"typed-parameter": {
			"comment": "Parameter type fallback before semantic tokens arrive; leave names to JavaScript parameter scopes.",
			"match": "\\b((?:(?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*|number|string|boolean|bigint|symbol|object)(?:\\[\\]|\\?)*)(?=[ \\t]+[$_a-zA-Z][\\w$]*\\b)",
			"captures": {
				"1": {
					"name": "storage.type.lgd"
				}
			}
		},
		"method-modifier": {
			"comment": "Contextual modifiers before methods, accessors, and constructors retain their theme roles.",
			"match": "(?<![\\w$.])\\b(abstract|virtual|override|public|protected|private|internal|sealed|static|async|readonly)\\b(?=[ \\t]+(?:(?:abstract|virtual|override|public|protected|private|internal|sealed|static|async|readonly)[ \\t]+)*(?:\\*[ \\t]*)?(?:(?:get|set)[ \\t]+)?(?:(?:void|(?:(?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*|number|string|boolean|bigint|symbol|object)(?:\\[\\]|\\?)*)[ \\t]+)?[$_a-zA-Z][\\w$]*[ \\t]*\\()",
			"captures": {
				"1": {
					"name": "storage.modifier.lgd"
				}
			}
		},
		"base-initializer-keyword": {
			"comment": "Constructor initializer fallback while the JavaScript grammar treats the colon as a return annotation.",
			"name": "variable.language.lgd",
			"match": "(?<![\\w$.])\\bbase\\b(?=[ \\t]*\\()"
		},
		"base-method-keyword": {
			"comment": "Direct base method dispatch in class bodies; native call scopes keep ordinary property names unchanged.",
			"name": "variable.language.lgd",
			"match": "(?<![\\w$.])\\bbase\\b(?=[ \\t]*\\.[ \\t]*[$_a-zA-Z][\\w$]*[ \\t]*\\()"
		},
		"typed-field": {
			"comment": "Modified fields and property contracts retain modifier, type, and name roles before semantic tokens arrive.",
			"match": "^[ \\t]*((?:(?:static|readonly|abstract|override|public|protected|private|internal)[ \\t]+)+)((?:(?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*|number|string|boolean|bigint|symbol|object)(?:\\[\\]|\\?)*)[ \\t]+([$_a-zA-Z][\\w$]*)(?=[ \\t]*[;={])",
			"captures": {
				"1": {
					"patterns": [
						{
							"match": "\\b(?:static|readonly|abstract|override|public|protected|private|internal)\\b",
							"name": "storage.modifier.lgd"
						}
					]
				},
				"2": {
					"name": "storage.type.lgd"
				},
				"3": {
					"name": "variable.other.definition.lgd"
				}
			}
		},
		"accessor-visibility": {
			"comment": "Restricted signature-only accessors retain visibility scopes inside property contracts.",
			"match": "(?<![\\w$.])\\b(public|protected|private|internal)\\b(?=[ \\t]+(?:get|set)[ \\t]*;)",
			"captures": {
				"1": {
					"name": "storage.modifier.lgd"
				}
			}
		},
		"type-cast": {
			"comment": "Conservative immediate type color for unambiguous cast heads; semantic tokens handle symbol-aware grouped operands.",
			"match": "(?<=[=(:,\\[!~?;{]|^return|[^\\w$.]return|^throw|[^\\w$.]throw|^)\\s*(\\()[ \\t]*((?:[$_a-zA-Z][\\w$]*\\.)*[A-Z][\\w$]*)(\\?)?[ \\t]*(\\))(?=[ \\t]*(?!in\\b|instanceof\\b)[$\\w'\"!~{])",
			"captures": {
				"1": {
					"name": "punctuation.section.cast.begin.lgd"
				},
				"2": {
					"name": "entity.name.type.class.lgd"
				},
				"3": {
					"name": "keyword.operator.nullable.lgd"
				},
				"4": {
					"name": "punctuation.section.cast.end.lgd"
				}
			}
		}
	},
	"scopeName": "source.lgd"
}
