// A launch configuration that launches the extension inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
    "configurations": [

        {
            "name": "Extension (Debug)",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "Build extension (Debug)",
            "runtimeExecutable": "${execPath}",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/dist"
            ]
        },
        {
            "name": "Extension (Production)",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "Build extension (Production)",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/dist"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Jest Test",
            "disableOptimisticBPs": true,
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": [
                "--config", "${workspaceFolder}/tests/jest.config.js",
                "--runInBand"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceRoot}"
        },
    ]
}
