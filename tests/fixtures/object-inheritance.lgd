const { Oloo } = require('@mavega/oloo');
const Object BaseCommand = require("./BaseCommand");
const Object vscode = require('vscode');

class GoToAssignment2 {
  constructor() {
  }

  Number test = 0;
}

/**
 * @description Command to go to the start of the assignment in the current line.
 * @extends {BaseCommandType}
 */
const Object GoToAssignment = {
  /**
   * @description Initialize an instance of GoToAssignment.
   * @returns {GoToAssignmentType}
   */
  create() {
    const Object goToAssignment = Oloo.assign(BaseCommand.create("lgd.goToAssignment", "Go To Assignment"), GoToAssignment);
    return goToAssignment;
  },

  async executeCommand() {
    const Object editor = vscode.window.activeTextEditor;
    if (!editor) {
      return;
    }

    const Object document = editor.document;
    const Object position = editor.selection.active;
    const String textLine = document.lineAt(position.line).text;
    Object match = textLine.match(/=(\s*)/);
    if (!match) {
      return;
    }

    Number assignmentIndex = match.index + match[0].length;
    if (assignmentIndex !== -1) {
      const Object newPosition = new vscode.Position(position.line, assignmentIndex);
      editor.selection = new vscode.Selection(newPosition, newPosition);
      editor.revealRange(new vscode.Range(newPosition, newPosition));
    }
  }
};

module.exports = GoToAssignment;
